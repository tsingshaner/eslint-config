{
  "$schema": "node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["./biome.shared.json"],
  "files": {
    "includes": ["**/*", "!fixtures/**/*"]
  },
  "overrides": [
    {
      "includes": ["scripts/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "off"
          }
        }
      },
      "includes": ["package.json"]
    }
  ]
}
