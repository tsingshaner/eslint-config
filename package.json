{
  "name": "@qingshaner/eslint-config",
  "type": "module",
  "version": "1.1.2",
  "packageManager": "pnpm@11.3.0",
  "description": "ESLint configs for qingshaner",
  "author": {
    "name": "qingshaner",
    "url": "https://github.com/Jon-a-than"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsingshaner/eslint-config"
  },
  "bugs": {
    "url": "https://github.com/tsingshaner/eslint-config"
  },
  "keywords": [
    "eslint",
    "eslint-config"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./biome": "./biome.shared.json",
    "./cspell": "./cspell.yaml"
  },
  "main": "dist/index.mjs",
  "types": "dist/src/index.d.mts",
  "files": [
    "biome.shared.json",
    "cspell.yaml",
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "changeset-version": "changeset version && node ./scripts/update-jsr-version.js",
    "changeset-publish": "changeset publish",
    "format": "biome format . --write",
    "gen": "pnpm gen:biome && pnpm gen:types",
    "gen:biome": "node ./scripts/ban-biome-impl-rules.ts",
    "gen:types": "tsx ./scripts/gen-rule-record-type.ts",
    "inspector": "pnpx @eslint/config-inspector",
    "lint": "biome lint . --write && eslint . --fix",
    "prepare": "simple-git-hooks",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:dev": "vitest",
    "knip": "knip"
  },
  "peerDependencies": {
    "@biomejs/biome": ">=2.4.0",
    "eslint": ">=10.3",
    "react": ">=19.0.0",
    "typescript": ">=6.0.0",
    "unocss": ">=66.0.0",
    "vue": ">=3.5.0"
  },
  "peerDependenciesMeta": {
    "@biomejs/biome": {
      "optional": true
    },
    "eslint": {
      "optional": false
    },
    "react": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "unocss": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@cspell/eslint-plugin": "^10.0.0",
    "@eslint/js": "^10.0.1",
    "@unocss/eslint-plugin": "^66.7.0",
    "eslint-merge-processors": "^2.0.0",
    "eslint-plugin-jsonc": "^3.1.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-vue": "^10.9.1",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "eslint-processor-vue-blocks": "^2.0.0",
    "globals": "^17.6.0",
    "typescript-eslint": "^8.60.0",
    "vue-eslint-parser": "^10.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": ">=2.4.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/compat": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
    "eslint-typegen": "^2.3.1",
    "jiti": "^2.7.0",
    "knip": "^6.14.2",
    "lint-staged": "^17.0.5",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.22.0",
    "tsx": "^4.22.3",
    "typescript": ">=6.0.0",
    "vitest": "^4.1.7"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "pre-push": "pnpm test"
  },
  "lint-staged": {
    "*.{vue,js,jsx,cjs,mjs,ts,tsx,cts,mts}": "pnpm lint",
    "*.{js,jsx,cjs,mjs,ts,tsx,cts,mts}": "pnpm biome format --write"
  }
}
